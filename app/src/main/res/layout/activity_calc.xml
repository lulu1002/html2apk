<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#111218" android:orientation="vertical" android:padding="12dp">

    <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="start" android:fontFamily="sans-serif-light"
        android:gravity="end" android:maxLines="1" android:paddingBottom="24dp"
        android:paddingEnd="8dp" android:singleLine="true" android:text="0"
        android:textColor="#FFFFFF" android:textSize="52sp" />

    <GridLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:columnCount="4" android:rowCount="5">

        <Button android:id="@+id/btnC" style="@style/CalcOp" android:text="C" />
        <Button android:id="@+id/btnDel" style="@style/CalcOp" android:text="⌫" />
        <Button android:id="@+id/btnPct" style="@style/CalcOp" android:text="%" />
        <Button android:id="@+id/btnDiv" style="@style/CalcOp" android:text="÷" />

        <Button android:id="@+id/btn7" style="@style/CalcNum" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcNum" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcNum" android:text="9" />
        <Button android:id="@+id/btnMul" style="@style/CalcOp" android:text="×" />

        <Button android:id="@+id/btn4" style="@style/CalcNum" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcNum" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcNum" android:text="6" />
        <Button android:id="@+id/btnSub" style="@style/CalcOp" android:text="−" />

        <Button android:id="@+id/btn1" style="@style/CalcNum" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcNum" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcNum" android:text="3" />
        <Button android:id="@+id/btnAdd" style="@style/CalcOp" android:text="+" />

        <Button android:id="@+id/btn0" style="@style/CalcNum" android:text="0"
            android:layout_columnSpan="2" android:layout_columnWeight="2" />
        <Button android:id="@+id/btnDot" style="@style/CalcNum" android:text="." />
        <Button android:id="@+id/btnEq" style="@style/CalcEq" android:text="=" />
    </GridLayout>
</LinearLayout>
