<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="3dp">

    <com.galeria.privada.SquareImageView
        android:id="@+id/img"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/surface" android:scaleType="centerCrop" />

    <View
        android:id="@+id/dim"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#88000000" android:visibility="gone" />

    <ImageView
        android:id="@+id/play"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="center" android:src="@drawable/ic_play" android:visibility="gone" />

    <ImageView
        android:id="@+id/check"
        android:layout_width="24dp" android:layout_height="24dp"
        android:layout_gravity="top|end" android:layout_margin="6dp"
        android:src="@drawable/ic_check" android:visibility="gone" />
</FrameLayout>
